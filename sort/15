#include <stdlib.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int** threeSum(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {
    // 1. Initialize variables and sort the array
    *returnSize = 0;
    if (numsSize < 3) {
        *returnColumnSizes = NULL;
        return NULL;
    }

    qsort(nums, numsSize, sizeof(int), compare);

    // Initial safe limit allocation for dynamic capacity resizing
    int max_results = 2000;
    int** result = (int**)malloc(max_results * sizeof(int*));
    *returnColumnSizes = (int*)malloc(max_results * sizeof(int));

    // 2. Loop to fix the first element (nums[i])
    for (int i = 0; i < numsSize - 2; i++) {
        // Optimization: If the smallest number is greater than 0, a sum of 0 is impossible
        if (nums[i] > 0) break;

        // Skip identical numbers to prevent duplicate triplets
        if (i > 0 && nums[i] == nums[i - 1]) continue;

        // 3. Initialize converging pointers
        int left = i + 1;
        int right = numsSize - 1;

        while (left < right) {
            int sum = nums[i] + nums[left] + nums[right];

            if (sum == 0) {
                // Match found! Allocate space for the triplet row
                result[*returnSize] = (int*)malloc(3 * sizeof(int));
                result[*returnSize][0] = nums[i];
                result[*returnSize][1] = nums[left];
                result[*returnSize][2] = nums[right];
                
                (*returnColumnSizes)[*returnSize] = 3; // Row has 3 elements
                (*returnSize)++;

                // Expand results buffer dynamically if limit is breached
                if (*returnSize >= max_results) {
                    max_results *= 2;
                    result = (int**)realloc(result, max_results * sizeof(int*));
                    *returnColumnSizes = (int*)realloc(*returnColumnSizes, max_results * sizeof(int));
                }

                // Move pointers forward and clear structural duplicates
                left++;
                right--;
                while (left < right && nums[left] == nums[left - 1]) left++;
                while (left < right && nums[right] == nums[right + 1]) right--;
            } 
            else if (sum < 0) {
                left++;  // Sum too small, we need a larger value
            } 
            else {
                right--; // Sum too large, we need a smaller value
            }
        }
    }

    return result;
}
